{
  "name": "flua",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "build:mobile": "MOBILE_BUILD=true next build",
    "cap:sync": "npx cap sync",
    "mobile": "npm run build:mobile && npm run cap:sync",
    "seed": "npx tsx scripts/seed-lunations.ts",
    "sync:csv": "npx tsx scripts/sync-csv-to-db.ts",
    "sync:sheets": "npx tsx scripts/sync-sheets.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "bcryptjs": "^2.4.3",
    "framer-motion": "^11.0.0",
    "next": "^16.0.9",
    "postgres": "^3.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.19.3",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3"
  }
