{
  "name": "flua",
  "version": "1.2.0-alpha",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "web:dev": "npm -w @flua/web run dev",
    "web:build": "npm -w @flua/web run build",
    "web:start": "npm -w @flua/web run start",
    "build:mobile": "npm -w @flua/web run build:mobile",
    "cap:sync": "npx cap sync",
    "mobile": "npm run build:mobile && npm run cap:sync",
    "seed": "npx tsx scripts/seed-lunations.ts",
    "sync:csv": "npx tsx scripts/sync-csv-to-db.ts",
    "sync:sheets": "npx tsx scripts/sync-sheets.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^22.19.3",
    "tsx": "^4.21.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
