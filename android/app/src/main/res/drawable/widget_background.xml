<?xml version="1.0" encoding="utf-8"?>
<!--
  🌌 Background do Widget
  Gradient espacial roxo/azul escuro
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Gradient de fundo espacial -->
    <gradient
        android:startColor="#0a0f1e"
        android:centerColor="#12183b"
        android:endColor="#1a1040"
        android:angle="135"
        android:type="linear" />

    <!-- Bordas arredondadas -->
    <corners android:radius="24dp" />

    <!-- Borda sutil -->
    <stroke
        android:width="1dp"
        android:color="#2a2a5a" />

</shape>
