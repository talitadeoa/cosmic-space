# ============================================================================
# 🌙 CONFIGURAÇÃO DE AMBIENTE - FLUA (Cosmic Space)
# ============================================================================
# Este arquivo serve como template para configurar variáveis de ambiente
# em desenvolvimento local e produção. NUNCA commite dados sensíveis!
#
# INSTRUÇÕES:
# - LOCAL: Copie para .env.local e preencha com suas credenciais locais
# - PRODUCTION: Defina variáveis no seu provedor de hospedagem (Vercel, etc)
# ============================================================================

# ============================================================================
# 🗄️  BANCO DE DADOS (DATABASE)
# ============================================================================
# PostgreSQL hospedado no Neon
#
# LOCAL: Use branch 'develop' ou 'local'
# PROD:  Use branch 'main' do Neon (com pool endpoint para melhor performance)
#
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
#
# Exemplo LOCAL:
# DATABASE_URL=postgresql://neondb_owner:SUA_SENHA@ep-exemplo-local.neon.tech/neondb?sslmode=require
#
# Exemplo PROD (com pooler):
# DATABASE_URL=postgresql://neondb_owner:SUA_SENHA@ep-exemplo-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&options=endpoint%3Dmain
#
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-exemplo.neon.tech/neondb?sslmode=require

# ============================================================================
# 🔐 AUTENTICAÇÃO
# ============================================================================
# Senha para autenticação básica no app (/universo)
AUTH_PASSWORD=cosmos2025

# TTL do token de autenticação em segundos
# 86400 = 24 horas | 604800 = 7 dias
AUTH_TOKEN_TTL_SECONDS=86400

# ============================================================================
# 🌐 URLS E CONFIGURAÇÃO DE PLATAFORMA
# ============================================================================
# URL base da aplicação (usada para SEO, links absolutos, e mobile WebView)
#
# LOCAL: http://localhost:3000 (ou http://192.168.1.X:3000 para testar no mobile)
# PROD:  https://seu-dominio.com
#
# ⚠️ OBRIGATÓRIO para builds Capacitor (iOS/Android)!
#    O WebView não tem "mesma origem", então APIs precisam de URL absoluta.
#
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL da API (se diferente do app, ex: API em outro servidor)
# Se não definida, usa NEXT_PUBLIC_APP_URL
NEXT_PUBLIC_API_URL=

# Deep link scheme do app (ex: flua://, myapp://)
NEXT_PUBLIC_APP_SCHEME=flua://

# Domínio para Universal Links (iOS) / App Links (Android)
# Ex: flua.app (sem https://)
NEXT_PUBLIC_APP_DOMAIN=

# [DEPRECADO] Use NEXT_PUBLIC_APP_URL ao invés disso
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ============================================================================
# 🔑 GOOGLE (Opcional)
# ============================================================================
# OAuth Google (para login via Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Service Account (para sincronizar lunações do Google Sheets)
# Use APENAS em produção se sincronizar sheets automaticamente
GOOGLE_SA_EMAIL=seu-service-account@seu-projeto.iam.gserviceaccount.com
GOOGLE_SA_KEY=-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n

# Google Sheets com dados das lunações
GOOGLE_LUNATIONS_SHEET_ID=seu-sheet-id-aqui

# ============================================================================
# 📧 EMAIL (Opcional)
# ============================================================================
# Configure se quiser enviar emails de notificação/registro
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@seu-dominio.com

# ============================================================================
# 🎯 OPCIONAL: OUTRAS CONFIGURAÇÕES
# ============================================================================
# Node environment (development, production, test)
NODE_ENV=development

# Debug mode (true/false)
DEBUG=false
