# ============================================
# AMBIENTE DE PRODUÇÃO - Exemplo de Variáveis
# ============================================

# Next.js
NODE_ENV=production
NEXT_PUBLIC_API_URL=http://api.cosmic-space.com:8000

# Banco de Dados PostgreSQL
DATABASE_URL=postgresql://cosmic_user:SENHA_SEGURA@postgres:5432/cosmic_db
POSTGRES_PASSWORD=SENHA_SEGURA
POSTGRES_USER=cosmic_user
POSTGRES_DB=cosmic_db

# Redis Cache
REDIS_URL=redis://redis:6379

# Python - Lunar Compute
PYTHONUNBUFFERED=1
LOG_LEVEL=info

# Autenticação / Segurança
JWT_SECRET=sua_chave_jwt_muito_segura_aqui
API_KEY=sua_api_key_segura_aqui

# Serviços Externos (se aplicável)
# SENDGRID_API_KEY=...
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Logs e Monitoramento
# SENTRY_DSN=...
# DATADOG_API_KEY=...
